{
    "version": "0.2.0",
    "configurations": [
        {
            "command": "npm run dev",
            "name": "Debug Release Hub Web",
            "request": "launch",
            "cwd": "${workspaceFolder}/apps/release-hub/web",
            "type": "node-terminal"
        },
        {
            "name": "Debug Release Hub Server",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/apps/release-hub/cmd/server",
            "cwd": "${workspaceFolder}",
            "env": {
                "HTTP_ADDR": ":8080",
                "DATA_PATH": "${workspaceFolder}/apps/release-hub/data/release-hub.db",
                "TOKEN_ENCRYPTION_KEY": "debug-dev-key",
                "SESSION_SECRET": "debug-dev-key"
            },
            "console": "integratedTerminal"
        }
    ]
}